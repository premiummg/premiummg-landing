{
  "name": "premiummg-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:prerender",
    "build:prerender": "vite build --ssr src/entry-prerender.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@premiummg/ui": "^0.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "resend": "^6.38.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^31.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
