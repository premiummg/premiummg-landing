# Copy to .env.local (gitignored) for `npm run dev`. On Vercel, set the same
# names under Project Settings -> Environment Variables instead.

# Estimate requests and newsletter sign-ups are emailed with Resend
# (https://resend.com). Without a key, `npm run dev` prints the email to the
# terminal instead of sending it; on Vercel the form answers with an error.
RESEND_API_KEY=

# Sender address. Its domain must be verified in Resend first; until then use
# Resend's sandbox sender: Premium Group <onboarding@resend.dev>
MAIL_FROM=Premium Group <no-reply@premiummg.ca>

# Optional: who receives estimate requests (default: info@premiummg.ca).
CONTACT_TO=

# Optional: a Resend audience to add newsletter sign-ups to. Without it, each
# sign-up is emailed to CONTACT_TO instead.
RESEND_AUDIENCE_ID=

# Cloudflare Turnstile captcha (free). Both set = required on every form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
