{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "api",
    "tests",
    "studio/schemaTypes/options.ts",
    "studio/schemaTypes/blocks.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.tsx"
  ]
}
